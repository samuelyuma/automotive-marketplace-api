NODE_ENV=development # options: development | production
LOG_LEVEL=info # options: debug | info | warn | error
PORT=8080 # API listening and published port

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234567890
POSTGRES_DB=automotive-marketplace
POSTGRES_HOST=127.0.0.1 # host address when running Bun outside Docker
POSTGRES_PORT=5432 # published host port

DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
# Set to the direct database URL when migrations must bypass a pooled connection.
# DATABASE_URL_UNPOOLED=postgres://user:password@direct-host:5432/database?sslmode=require

REDIS_BACKEND=tcp # options: tcp | upstash
REDIS_HOST=127.0.0.1 # host address when running Bun outside Docker
REDIS_PORT=6379 # published host port
REDIS_URL=redis://$REDIS_HOST:$REDIS_PORT

# For REDIS_BACKEND=upstash, set both credentials from Upstash.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
