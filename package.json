{
  "name": "automotive-marketplace",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysia/openapi": "^1.4.16",
    "@sinclair/typebox": "0.34.52",
    "elysia": "latest",
    "pino": "10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "7.0.2"
  },
  "module": "src/index.js",
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
